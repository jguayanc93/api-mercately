# ---------- App ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------- SQL Server (solo lectura) ----------
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
# true si el servidor exige TLS (Azure SQL siempre true)
DB_ENCRYPT=false
# true en servidores locales con certificado autofirmado
DB_TRUST_SERVER_CERTIFICATE=true

# Tablas propias de esta API (las crea sql/001_tablas_sync.sql).
# La tabla de productos del ERP no figura aca: es de solo lectura y su consulta
# vive en src/productos/origen.js
DB_ESQUEMA=dbo
DB_TABLA_SYNC_PRODUCTO=tbl01_api_mercately_sync_producto
DB_TABLA_SYNC_EJECUCION=tbl01_api_mercately_sync_ejecucion
DB_TABLA_SYNC_EVENTO=tbl01_api_mercately_sync_evento

# ---------- API del proveedor (Mercately) ----------
PROVIDER_BASE_URL=https://mercately.shop/api/v1
PROVIDER_API_KEY=
PROVIDER_TIMEOUT_MS=30000
# No publican limite de llamadas: 200ms entre requests = 5 por segundo
PROVIDER_MIN_INTERVAL_MS=200
PROVIDER_MAX_RETRIES=3

# ---------- Sincronizacion ----------
# Cada 3 minutos. Un ciclo sin cambios cuesta ~0,2s, y la cantidad de llamadas
# al proveedor no depende de la frecuencia: solo de cuantos productos cambian.
SYNC_CRON=*/3 * * * *
SYNC_ENABLED=true
# Llamadas al proveedor en paralelo (PROVIDER_MIN_INTERVAL_MS sigue limitando el ritmo total)
SYNC_CONCURRENCIA=4
# subcategory_id es opcional en Mercately (probado). En true, los productos sin
# subcategoria mapeada se omiten en vez de publicarse sin categorizar.
SYNC_EXIGIR_SUBCATEGORIA=false
# El PUT no documenta si image_urls reemplaza o agrega la galeria: apagado por defecto
SYNC_ENVIAR_IMAGENES_EN_UPDATE=false
# Freno de mano: aborta las bajas si superan este % del catalogo publicado
SYNC_MAX_BAJAS_PORCENTAJE=20
